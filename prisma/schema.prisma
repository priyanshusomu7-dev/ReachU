// Prisma schema for ReachU Admin Panel & Public Website
// Database: MongoDB (Prisma MongoDB provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("SUPER_ADMIN") // SUPER_ADMIN, EDITOR, VIEWER
  status       String     @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  offersCreated Offer[]
  auditLogs     AuditLog[]
}

model Offer {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  slug                 String     @unique
  shortDescription     String
  description          String?
  promoCode            String     @unique
  discountType         String     @default("FIXED") // FIXED, PERCENTAGE
  discountValue        Float
  minimumBookingAmount Float?
  maximumDiscount      Float?
  usageLimit           Int?
  perUserLimit         Int?       @default(1)
  startAt              DateTime
  endAt                DateTime
  status               String     @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, EXPIRED, INACTIVE
  isActive             Boolean    @default(true)
  imageUrl             String?
  thumbnailUrl         String?
  applicableService    String?    @default("ALL") // ALL, PARCEL, SHIFTING, TRANSPORT
  isNewUserOnly        Boolean    @default(false)
  displayOrder         Int        @default(0)
  isDeleted            Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  createdById          String?    @db.ObjectId
  createdBy            AdminUser? @relation(fields: [createdById], references: [id])

  @@index([status, isActive, isDeleted])
  @@index([startAt, endAt])
}

model Announcement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  message       String
  ctaText       String?
  ctaUrl        String?
  imageUrl      String?
  startAt       DateTime?
  endAt         DateTime?
  status        String    @default("ACTIVE") // DRAFT, SCHEDULED, ACTIVE, EXPIRED, INACTIVE
  isActive      Boolean   @default(true)
  isDismissible Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, isActive])
}

model Service {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String   @unique
  shortDescription    String
  detailedDescription String?
  imageUrl            String?
  icon                String?
  displayOrder        Int      @default(0)
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE
  ctaText             String?
  ctaUrl              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, displayOrder])
}

model WebsiteContent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sectionKey  String   @unique // hero, why-reachu, how-it-works, driver-cta, final-cta, footer
  content     String   // Serialized JSON content
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.ObjectId
}

model AppLink {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  targetAudience String   // CUSTOMER, DRIVER
  appName        String
  playStoreUrl   String
  appStoreUrl    String
  qrCodeUrl      String?
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  updatedAt      DateTime @updatedAt

  @@index([targetAudience])
}

model Media {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  filename     String
  originalName String
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String?  @db.ObjectId
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  category  String   @default("GENERAL") // GENERAL, CONTACT, SOCIAL, SEO
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String?    @db.ObjectId
  adminEmail String?
  action     String     // LOGIN, LOGOUT, OFFER_CREATE, OFFER_UPDATE, etc.
  entityType String     // Offer, Announcement, Service, Setting, Content, AppLink, Media
  entityId   String?
  metadata   String?    // Serialized JSON metadata
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  admin      AdminUser? @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
