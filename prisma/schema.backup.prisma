// SQLite schema backup — no longer active.
// The production schema now uses MongoDB (see schema.prisma).
// This file is kept for reference only.
//
// To restore PostgreSQL: copy this content to schema.prisma,
// update DATABASE_URL to a postgres:// connection string,
// and run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("SUPER_ADMIN")
  status       String     @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  offersCreated Offer[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Offer {
  id                   String     @id @default(cuid())
  title                String
  slug                 String     @unique
  shortDescription     String
  description          String?
  promoCode            String     @unique
  discountType         String     @default("FIXED")
  discountValue        Float
  minimumBookingAmount Float?
  maximumDiscount      Float?
  usageLimit           Int?
  perUserLimit         Int?       @default(1)
  startAt              DateTime
  endAt                DateTime
  status               String     @default("DRAFT")
  isActive             Boolean    @default(true)
  imageUrl             String?
  thumbnailUrl         String?
  applicableService    String?    @default("ALL")
  isNewUserOnly        Boolean    @default(false)
  displayOrder         Int        @default(0)
  isDeleted            Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  createdById          String?
  createdBy            AdminUser? @relation(fields: [createdById], references: [id])

  @@index([status, isActive, isDeleted])
  @@index([promoCode])
  @@index([startAt, endAt])
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  message       String
  ctaText       String?
  ctaUrl        String?
  imageUrl      String?
  startAt       DateTime?
  endAt         DateTime?
  status        String    @default("ACTIVE")
  isActive      Boolean   @default(true)
  isDismissible Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, isActive])
}

model Service {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  shortDescription    String
  detailedDescription String?
  imageUrl            String?
  icon                String?
  displayOrder        Int      @default(0)
  status              String   @default("ACTIVE")
  ctaText             String?
  ctaUrl              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, displayOrder])
}

model WebsiteContent {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  content     String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([sectionKey])
}

model AppLink {
  id             String   @id @default(cuid())
  targetAudience String
  appName        String
  playStoreUrl   String
  appStoreUrl    String
  qrCodeUrl      String?
  description    String?
  status         String   @default("ACTIVE")
  updatedAt      DateTime @updatedAt

  @@index([targetAudience])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  adminEmail String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  admin      AdminUser? @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
